
# job-board-application — application.yml.example


spring:
  application:
    name: job-board-application

  datasource:
    url: ${DB_URL:jdbc:mysql://localhost:3306/jobboard_db}
    username: ${DB_USERNAME:root}
    password: ${DB_PASSWORD:yourpassword}
    driver-class-name: com.mysql.cj.jdbc.Driver

  jpa:
    hibernate:
      ddl-auto: update
    show-sql: true
    properties:
      hibernate:
        dialect: org.hibernate.dialect.MySQLDialect

  data:
    redis:
      host: localhost
      port: 6379

  kafka:
    bootstrap-servers: localhost:9092
    consumer:
      group-id: jobboard-default-group
      auto-offset-reset: earliest
      key-deserializer: org.apache.kafka.common.serialization.StringDeserializer
      value-deserializer: org.springframework.kafka.support.serializer.JsonDeserializer
      properties:
        spring:
          json:
            trusted:
              packages: "*"
            use:
              type:
                headers: false
    producer:
      key-serializer: org.apache.kafka.common.serialization.StringSerializer
      value-serializer: org.springframework.kafka.support.serializer.JsonSerializer

server:
  port: 8080

aws:
  access-key: YOUR_AWS_ACCESS_KEY
  secret-key: YOUR_AWS_SECRET_KEY
  region: eu-north-1
  s3:
    bucket-name: YOUR_BUCKET_NAME

jwt:
  secret: YOUR_JWT_SECRET_KEY_MIN_32_CHARS
  expiration: 86400000

gemini:
  api-key: YOUR_GEMINI_API_KEY
  api-url: https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent

management:
  endpoints:
    web:
      exposure:
        include: health,info